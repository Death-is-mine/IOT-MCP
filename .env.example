# Copy to .env (never commit .env). See docs/03_TRD.md section 8.
CEM_DB_MODE=memory
CEM_AUTH_MODE=dev
CEM_CONTROL_ENABLED=false
CEM_MAX_BODY_KB=256
CEM_INGEST_RATE_PER_MIN=20
CEM_DISPLAY_TZ=Asia/Kolkata
CEM_BIND_HOST=127.0.0.1
CEM_PORT=8080
CEM_EXPORT_DIR=./var/exports
CEM_BACKUP_DIR=./var/backups
# Production (Firebase) only:
# CEM_DB_MODE=firestore
# CEM_AUTH_MODE=firebase
# CEM_FIREBASE_PROJECT_ID=iot-mcp
# CEM_FIREBASE_REGION=asia-south1
# FIREBASE_SERVICE_ACCOUNT_JSON=/run/secrets/cem-firebase.json
# Dev only (required when CEM_AUTH_MODE=dev):
# CEM_DEV_SECRET=change-me
# First admin, auto-created on boot when missing (dev only):
# CEM_DEV_ADMIN=you@example.com
# Read-only MCP server (python mcp_server.py; AIRD S1, separate process):
# CEM_MCP_GATEWAY=http://127.0.0.1:8080
# CEM_MCP_GATEWAY_TOKEN=viewer-token-here
# CEM_MCP_TOKEN=caller-token-here
# CEM_MCP_HOST=127.0.0.1
# CEM_MCP_PORT=8090
# CEM_MCP_RATE_PER_MIN=120
