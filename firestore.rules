// Firestore security rules (production). Append-only audit/labels,
// node subcollections written only via backend (Admin SDK bypasses rules),
// users readable by backend only. Deploy: firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function backend() { return false; } // all access via Admin SDK only
    match /readings/{n}/samples/{s} { allow read, write: if backend(); }
    match /events/{n}/entries/{e} { allow read, write: if backend(); }
    match /nodes/{n} { allow read, write: if backend(); }
    match /flags/{f} {
      allow create: if backend();
      allow update, delete: if false; // derived history is append-only
    }
    match /flag_watermarks/{w} { allow read, write: if backend(); }
    match /labels/{l} {
      allow create: if backend();
      allow update: if backend()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['superseded_by']);
      allow delete: if false; // immutable ground truth
    }
    match /timetable/{t} { allow read, write: if backend(); }
    match /users/{u} { allow read, write: if backend(); }
    match /audit_log/{a} {
      allow create: if backend();
      allow update, delete: if false; // FR-081/SEC-07
    }
    match /eval_runs/{r} { allow read, write: if backend(); }
    match /config/{k} { allow read, write: if backend(); }
  }
}
